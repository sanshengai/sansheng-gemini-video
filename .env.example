# sansheng-gemini-video -- environment variables
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# (Env vars take priority; this .env is only a fallback the scripts read.)

# --- API key (required) ---
# Your Gemini API key. Two kinds are auto-detected by prefix:
#   - AI Studio key  (starts with "AIza")  -> generativelanguage endpoint, nothing else needed.
#   - Vertex Express key (starts with "AQ.") -> Vertex endpoint, also set GEMINI_VERTEX_PROJECT below.
# GEMINI_API_KEY is also accepted if you prefer that name.
GOOGLE_API_KEY=

# --- Vertex AI Express only (leave blank for AI Studio keys) ---
# Required ONLY when your key starts with "AQ." (Vertex Express). Your GCP project id.
GEMINI_VERTEX_PROJECT=
# Vertex location. Gemini 3.x lives on "global"; leave as-is unless you know otherwise.
GEMINI_VERTEX_LOCATION=global

# --- optional tuning ---
# Model id. Set to whatever your key/plan can call.
GEMINI_MODEL=gemini-3.5-flash
# Inline upload size cap in MB (source file size, not base64). Files above this get compressed.
GEMINI_INLINE_MAX_MB=70

# --- optional URL download routes ---
# Bilibili / Xiaohongshu / Douyin and most other sites use local yt-dlp first.
# If yt-dlp is blocked and you explicitly configure this key, supported short-video URLs
# may be sent to the AI Douyin resolver as a fallback.
AI_DOUYIN_API_KEY=
AI_DOUYIN_API_BASE=https://ai-douyin.top9.cc

# WeChat Channels: recommended one-time auth is:
#   python scripts/wechat_auth.py
# It stores the Yuanbao Web Cookie with Windows DPAPI outside this repository.
# The two variables below are explicit fallbacks for CI/non-Windows; never commit real values.
GEMINI_VIDEO_YUANBAO_COOKIE=
GEMINI_VIDEO_YUANBAO_COOKIE_FILE=

# Optional last-resort fallback only. The skill never starts WeChat, a proxy, or this service.
GEMINI_VIDEO_WECHAT_API_BASE=http://127.0.0.1:2022
